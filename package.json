{
	"name": "italystrap",
	"title": "A powerfull theme framework for WordPress",
	"description": "",
	"author": "Enea Overclokk",
	"homepage": "https://italystrap.com",
	"version": "4.0.0-beta.8",
	"license": "GPL-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/ItalyStrap/italystrap.git"
	},
	"devDependencies": {
		"@wordpress/scripts": "^31.6.0",
		"clean-webpack-plugin": "^4.0.0",
		"ajv": "^8.18.0",
		"ajv-keywords": "^5.1.0",
		"sass": "^1.93.1",
		"typescript": "^4.4.3"
	},
	"scripts": {
		"format": "wp-scripts format \"assets/**/*.{css,scss,js,ts}\"",
		"format:check": "wp-scripts format --check \"assets/**/*.{css,scss,js,ts}\"",
		"build": "wp-scripts build",
		"lint": "npm run lint:js && npm run lint:style",
		"lint:js": "wp-scripts lint-js \"assets/ts/**/*.ts\" webpack.config.js --no-error-on-unmatched-pattern",
		"lint:js:fix": "npm run lint:js -- --fix",
		"lint:style": "wp-scripts lint-style \"assets/sass/**/*.scss\" --allow-empty-input",
		"lint:style:fix": "npm run lint:style -- --fix",
		"start": "wp-scripts start"
	}
}
